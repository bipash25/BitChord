# Listen Together server (https://host). Required: `vite build` fails without
# it. Production sets it in the Cloudflare Pages environment.
VITE_PARTY_SERVER_URL=

# Where the Android app banner points on mobile browsers.
VITE_ANDROID_APP_URL=https://github.com/kushagrasinghx/BitChord/releases/latest

# The server relay (web/docs/relay.md), https://host: the site's only
# transport. Playback, search, lyrics and addons all travel through it, so
# without it nothing can play. Empty or unset = off. Production sets it in
# the Cloudflare Pages environment; locally, run `web/relay` on :8787 and
# point this at http://localhost:8787.
VITE_RELAY_URL=

# The Spotify app's client id (web/README.md's "Spotify" section): the page
# signs in with PKCE, so no client secret is ever set or needed. Register the
# app in the Spotify dashboard, list the site's and localhost's redirect URIs
# (https://yoursite/spotify and http://localhost:5173/spotify), and paste its
# client id here. Empty or unset = Spotify simply isn't configured: every
# Spotify surface shows its quiet "not configured" state.
VITE_SPOTIFY_CLIENT_ID=
